{
    "name": "batuhan-kahraman35/turkbelge-efatura-php",
    "description": "Türkbelge e-Fatura / e-Arşiv SOAP servisleri için framework'ten bağımsız PHP istemcisi",
    "type": "library",
    "license": "MIT",
    "keywords": ["turkbelge", "e-fatura", "e-arsiv", "efatura", "earsiv", "ubl-tr", "gib", "soap"],
    "authors": [
        {
            "name": "Batuhan KAHRAMAN",
            "homepage": "https://github.com/Batuhan-Kahraman35"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-dom": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-xsl": "Fatura XML'ini XSLT ile HTML'e çevirmek için"
    },
    "autoload": {
        "psr-4": {
            "Turkbelge\\EFatura\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Turkbelge\\EFatura\\Testler\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite birim",
        "test-entegrasyon": "phpunit --testsuite entegrasyon",
        "ubl-xsd": "@php bin/ubl-xsd-indir.php"
    },
    "minimum-stability": "stable"
}
